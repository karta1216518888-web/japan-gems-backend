// This is your Prisma schema file
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==========================================
// 地域結構 (全國規劃 - 8地方、47都道府縣)
// ==========================================

model Region {
  id          String   @id @default(cuid())
  name        String   @unique  // e.g., "關西地方"
  nameJa      String            // e.g., "関西地方"
  nameEn      String?           // e.g., "Kansai"
  prefecture  Prefecture[]
  spots       Spot[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Prefecture {
  id          String   @id @default(cuid())
  name        String   // e.g., "大阪府"
  nameJa      String
  nameEn      String?  // e.g., "Osaka"
  regionId    String
  region      Region   @relation(fields: [regionId], references: [id])
  cities      City[]
  spots       Spot[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model City {
  id             String   @id @default(cuid())
  name           String   // e.g., "大阪市"
  nameJa         String
  nameEn         String?
  prefectureId   String
  prefecture    Prefecture @relation(fields: [prefectureId], references: [id])
  spots          Spot[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ==========================================
// 景點分類系統
// ==========================================

model Category {
  id          String   @id @default(cuid())
  name        String   @unique  // e.g., "自然景觀"
  nameJa      String            // e.g., "自然景観"
  nameEn      String?           // e.g., "Nature"
  spots       SpotCategory[]
  createdAt   DateTime @default(now())
}

// 景點-分類 多對多關聯
model SpotCategory {
  spotId     String
  categoryId String
  spot       Spot     @relation(fields: [spotId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id])
  
  @@id([spotId, categoryId])
}

// ==========================================
// 景點 (核心資料表)
// ==========================================

model Spot {
  id          String   @id @default(cuid())
  
  // 多語言名稱
  name        String              // 預設名稱
  nameJa      String?
  nameEn      String?
  
  // 描述
  description String
  localTip   String?            // 在地人小技巧
  
  // 位置
  latitude    Float
  longitude   Float
  address     String?
  
  // --------------------------------------
  // 旅遊資訊
  // --------------------------------------
  languageBarrier    Int        @default(3)  // 1-5 語言友善度
  paymentMethods    String?     // 支援的付款方式 (JSON: ["cash","visa","suica"])
  businessHours    String?     // 營業時間
  closedDays       String?     // 休館日 (JSON: ["Monday","Tuesday"])
  budgetMin        Int?        // 最低消費
  budgetMax        Int?        // 最高消費
  avgVisitTime     Int?        // 平均參觀時間 (分鐘)
  
  // --------------------------------------
  // 無障礙設施 (Accessibility)
  // --------------------------------------
  wheelchairAccess  Boolean    @default(false)  // 輪椅友善
  elevatorAccess   Boolean    @default(false)  // 有電梯
  parkingAvailable Boolean    @default(false)  // 有停車場
  blindFriendly    Boolean    @default(false)  // 視障友善
  deafFriendly    Boolean    @default(false)  // 聽障友善
  
  // --------------------------------------
  // 聯絡資訊
  // --------------------------------------
  phone          String?
  website        String?
  instagram      String?
  twitter        String?
  facebook       String?
  
  // --------------------------------------
  // 季節性資訊
  // --------------------------------------
  bestSeason     String?     // 最佳季節 (JSON: ["spring","autumn"])
  peakHours      String?     // 尖峰時段
  offPeakHours   String?     // 離峰時段
  
  // --------------------------------------
  // 狀態與時間
  // --------------------------------------
  status         String     @default("active")  // active, closed, relocated
  
  // 關聯
  regionId        String?
  prefectureId    String?
  cityId          String?
  
  region          Region?        @relation(fields: [regionId], references: [id])
  prefecture      Prefecture?    @relation(fields: [prefectureId], references: [id])
  city            City?          @relation(fields: [cityId], references: [id])
  categories      SpotCategory[]
  references      Reference[]
  photos          Photo[]
  restaurantInfo  RestaurantInfo?  // 餐廳資訊 (未來擴充)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==========================================
// 參考資料來源 (核心功能)
// ==========================================

model Reference {
  id          String   @id @default(cuid())
  spotId      String
  spot        Spot     @relation(fields: [spotId], references: [id], onDelete: Cascade)
  
  // 基本資料
  type            String   // blog, article, social, video, guidebook
  title           String
  url             String
  author          String?
  source          String   // 來源網站/部落格名稱
  language        String   // 內容語言
  
  // 內容
  publishDate     DateTime?
  quotedContent   String?  // 引用片段
  
  // 品質分類
  quality         String   @default("secondary")  // primary, secondary, user_generated
  
  // --------------------------------------
  // 可靠性評分系統
  // --------------------------------------
  reliabilityScore    Int       @default(50)   // 1-100 系統計算
  manualOverride      Int?                  // 老闆人工覆蓋
  lastVerified       DateTime?             // 上次驗證時間
  
  // 來源關聯 (用於批量管理)
  sourceId    String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==========================================
// 照片
// ==========================================

model Photo {
  id          String   @id @default(cuid())
  spotId      String
  spot        Spot     @relation(fields: [spotId], references: [id], onDelete: Cascade)
  
  url         String
  caption     String?
  isPrimary   Boolean  @default(false)
  photographer String?  // 攝影者
  
  createdAt   DateTime @default(now())
}

// ==========================================
// 來源管理 (可靠性追蹤)
// ==========================================

model Source {
  id          String   @id @default(cuid())
  name        String   @unique  // 來源名稱
  url         String
  type        String   // blog, news, social, etc.
  language    String   // 主要語言
  
  // 預設可靠性權重
  defaultReliability Int @default(50)
  
  // 老闆設定
  isBlacklisted      Boolean @default(false)  // 黑名單
  isWhitelisted     Boolean @default(false)  // 白名單
  manualNotes       String?  // 備註
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==========================================
// 餐廳資訊 (未來擴充)
// ==========================================

model RestaurantInfo {
  id              String   @id @default(cuid())
  spotId          String   @unique
  spot            Spot     @relation(fields: [spotId], references: [id], onDelete: Cascade)
  
  priceRange      String?   // ¥, ¥¥, ¥¥¥
  cuisine         String?   // 料理類型 (JSON)
  reservation     Boolean   @default(false)  // 需要預約
  seatingCapacity Int?      // 座位數
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

